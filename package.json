{
  "name": "pixel-pet-chat",
  "productName": "PixelPet",
  "version": "0.1.3",
  "description": "바탕화면 픽셀 펫 + 친구 채팅",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --x64"
  },
  "build": {
    "appId": "com.pixelpet.chat",
    "productName": "PixelPet",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "identity": "-", "hardenedRuntime": false
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "pretendard": "^1.3.9"
  }
}
